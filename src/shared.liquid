{%- comment -%}
  Daily rotation is a function of the local calendar date, never the refresh count.
  utc_offset is supplied by TRMNL in seconds; using the current offset handles DST.
  No polling, Serverless function, Saved State or external quote service is needed.
{%- endcomment -%}
{%- assign le_language = trmnl.plugin_settings.custom_fields_values.language | default: "en" -%}
{%- unless le_language == "de" -%}{%- assign le_language = "en" -%}{%- endunless -%}
{%- assign le_utc_now = trmnl.system.timestamp_utc | default: 0 | plus: 0 -%}
{%- if le_utc_now == 0 -%}{%- assign le_utc_now = "now" | date: "%s" | plus: 0 -%}{%- endif -%}
{%- assign le_offset = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- assign le_local_now = le_utc_now | plus: le_offset -%}
{%- assign le_local_day = le_local_now | divided_by: 86400 | floor -%}
{%- assign le_pool = entries | default: data.entries -%}
{%- assign le_count = le_pool | size -%}
{%- assign le_anchor = epoch_local_day | default: data.epoch_local_day | default: 20743 -%}
{%- assign le_quote = "Your plans are still loading." -%}
{%- assign le_entry_id = "fallback" -%}
{%- if le_count > 0 -%}
  {%- assign le_index = le_local_day | minus: le_anchor | modulo: le_count | plus: le_count | modulo: le_count -%}
  {%- assign le_entry = le_pool[le_index] -%}
  {%- assign le_quote = le_entry[le_language] | default: le_entry.en -%}
  {%- assign le_entry_id = le_entry.id -%}
{%- elsif le_language == "de" -%}
  {%- assign le_quote = "Deine Pläne werden noch geladen." -%}
{%- endif -%}
{%- assign le_date = le_local_now | date: "%Y-%m-%d" -%}
{%- assign le_day = le_local_now | date: "%d" | plus: 0 -%}
{%- assign le_year = le_local_now | date: "%Y" | plus: 0 -%}
{%- assign le_day_of_year = le_local_now | date: "%j" | plus: 0 -%}
{%- assign le_weekday_index = le_local_now | date: "%w" | plus: 0 -%}
{%- assign le_month_index = le_local_now | date: "%m" | minus: 1 -%}
{%- assign le_weekdays = "SUNDAY|MONDAY|TUESDAY|WEDNESDAY|THURSDAY|FRIDAY|SATURDAY" | split: "|" -%}
{%- assign le_months = "JANUARY|FEBRUARY|MARCH|APRIL|MAY|JUNE|JULY|AUGUST|SEPTEMBER|OCTOBER|NOVEMBER|DECEMBER" | split: "|" -%}
{%- assign le_tagline = "DAILY DEMOTIVATION" -%}
{%- assign le_day_label = "DAY" -%}
{%- assign le_of_label = "OF" -%}
{%- assign le_instance = "English" -%}
{%- if le_language == "de" -%}
  {%- assign le_weekdays = "SONNTAG|MONTAG|DIENSTAG|MITTWOCH|DONNERSTAG|FREITAG|SAMSTAG" | split: "|" -%}
  {%- assign le_months = "JANUAR|FEBRUAR|MÄRZ|APRIL|MAI|JUNI|JULI|AUGUST|SEPTEMBER|OKTOBER|NOVEMBER|DEZEMBER" | split: "|" -%}
  {%- assign le_tagline = "TÄGLICHE DEMOTIVATION" -%}
  {%- assign le_day_label = "TAG" -%}
  {%- assign le_of_label = "VON" -%}
  {%- assign le_instance = "Deutsch" -%}
{%- endif -%}
{%- assign le_weekday = le_weekdays[le_weekday_index] -%}
{%- assign le_month = le_months[le_month_index] -%}
{%- assign le_days_in_year = 365 -%}
{%- assign le_mod4 = le_year | modulo: 4 -%}
{%- assign le_mod100 = le_year | modulo: 100 -%}
{%- assign le_mod400 = le_year | modulo: 400 -%}
{%- if le_mod4 == 0 and le_mod100 != 0 -%}{%- assign le_days_in_year = 366 -%}{%- endif -%}
{%- if le_mod400 == 0 -%}{%- assign le_days_in_year = 366 -%}{%- endif -%}
{%- assign le_quote_length = le_quote | size -%}
{%- assign le_length_class = "" -%}
{%- if le_quote_length > 68 -%}{%- assign le_length_class = "le-long" -%}{%- endif -%}
{%- if le_quote_length > 86 -%}{%- assign le_length_class = "le-long le-dense" -%}{%- endif -%}
{%- capture le_newline %}
{% endcapture -%}
{%- assign le_quote_lines = le_quote | split: le_newline -%}

<style>
  .le-view .le-layout { padding: 12px 18px 10px; min-height: 0; display: flex; flex: 1; flex-direction: column; align-items: stretch; justify-content: stretch; gap: 0; }
  .le-view .le-paper, .le-view .le-paper * { box-sizing: border-box; }
  .le-view .le-paper { position: relative; color: #000; background: #fff; border: 0; border-bottom: 1px solid #000; margin: 0 0 7px; min-height: 0; flex: 1; display: flex; flex-direction: column; font-family: "Inter Variable", Arial, sans-serif; }
  .le-view .le-paper::before, .le-view .le-paper::after { content: ""; position: absolute; height: 1px; background: #000; pointer-events: none; }
  .le-view .le-paper::before { left: 5px; right: 5px; bottom: -4px; }
  .le-view .le-paper::after { left: 10px; right: 10px; bottom: -7px; }
  .le-view .le-binding { height: 21px; flex: 0 0 21px; position: relative; background: linear-gradient(to bottom, #000 0, #000 10px, #fff 10px, #fff 100%); border-bottom: 1px dashed #000; }
  .le-view .le-binding::before, .le-view .le-binding::after { content: ""; position: absolute; top: 3px; width: 23px; height: 3px; background: #fff; }
  .le-view .le-binding::before { left: 26%; }
  .le-view .le-binding::after { right: 26%; }
  .le-view .le-masthead { display: flex; flex: 0 0 auto; justify-content: space-between; align-items: baseline; gap: 12px; margin: 15px 26px 0; padding: 0; border: 0; }
  .le-view .le-brand { font-family: Georgia, "Times New Roman", serif; font-style: italic; font-size: 18px; font-weight: 400; letter-spacing: 0; line-height: 1.2; }
  .le-view .le-edition { font-size: 11px; line-height: 1; letter-spacing: 1px; }
  .le-view .le-body { display: flex; flex: 1; min-height: 0; align-items: center; gap: 44px; padding: 18px 30px 18px 26px; }
  .le-view .le-date { flex: 0 0 215px; text-align: center; padding: 0; border: 0; }
  .le-view .le-weekday, .le-view .le-month { font-size: 12px; font-weight: 600; letter-spacing: 1.7px; line-height: 1.25; }
  .le-view .le-number { font-family: "Inter Variable", Arial, sans-serif; font-variant-numeric: lining-nums tabular-nums; font-size: 184px; font-weight: 700; letter-spacing: -0.085em; line-height: 0.94; margin: 7px 0 8px; padding-right: 0.085em; }
  .le-view .le-quote { flex: 1; min-width: 0; margin: 0; padding: 0; font-family: Georgia, "Times New Roman", serif; font-size: 39px; font-weight: 400; line-height: 1.16; letter-spacing: -0.4px; white-space: pre-line; hyphens: none; overflow-wrap: break-word; }
  .le-view .le-setup { display: block; font-family: "Inter Variable", Arial, sans-serif; font-size: 0.61em; font-weight: 400; font-style: normal; line-height: 1.35; letter-spacing: -0.015em; }
  .le-view .le-punchline { display: block; margin-top: 13px; font-style: italic; line-height: 1.14; }
  .le-view .le-long .le-quote { font-size: 35px; }
  .le-view .le-dense .le-quote { font-size: 33px; }
  .le-view .le-footer { display: flex; flex: 0 0 auto; justify-content: flex-end; gap: 12px; margin: 0 26px; padding: 3px 0 10px; border: 0; font-size: 10px; line-height: 1.2; letter-spacing: 0.9px; }
  .le-view .le-footer-year { display: none; }
  .le-view .le-mark { width: 20px; height: 20px; }
  .le-horizontal .le-layout, .le-quadrant .le-layout { padding: 6px 12px 8px; }
  .le-horizontal .le-binding, .le-quadrant .le-binding { height: 12px; flex-basis: 12px; background: linear-gradient(to bottom, #000 0, #000 5px, #fff 5px, #fff 100%); }
  .le-horizontal .le-binding::before, .le-horizontal .le-binding::after,
  .le-quadrant .le-binding::before, .le-quadrant .le-binding::after { top: 1px; width: 16px; height: 2px; }
  .le-horizontal .le-masthead, .le-vertical .le-masthead, .le-quadrant .le-masthead { display: none; }
  .le-horizontal .le-body { gap: 34px; padding: 10px 24px 12px 18px; }
  .le-horizontal .le-date { flex-basis: 168px; }
  .le-horizontal .le-number { font-size: 100px; margin: 4px 0 5px; }
  .le-horizontal .le-weekday, .le-horizontal .le-month { font-size: 11px; letter-spacing: 1.2px; }
  .le-horizontal .le-quote { font-size: 30px; }
  .le-horizontal .le-long .le-quote { font-size: 27px; }
  .le-horizontal .le-dense .le-quote { font-size: 25px; }
  .le-horizontal .le-punchline { margin-top: 8px; }
  .le-horizontal .le-footer, .le-quadrant .le-footer { display: none; }
  .le-vertical .le-binding { height: 17px; flex-basis: 17px; background: linear-gradient(to bottom, #000 0, #000 7px, #fff 7px, #fff 100%); }
  .le-vertical .le-binding::before, .le-vertical .le-binding::after { top: 2px; width: 19px; height: 2px; }
  .le-vertical .le-body { flex-direction: column; justify-content: center; gap: 23px; padding: 16px 24px; }
  .le-vertical .le-date { flex: 0 0 auto; }
  .le-vertical .le-number { font-size: 112px; margin: 5px 0 6px; }
  .le-vertical .le-weekday, .le-vertical .le-month { font-size: 11px; letter-spacing: 1.4px; }
  .le-vertical .le-quote { flex: 0 0 auto; width: 100%; font-size: 28px; text-align: center; }
  .le-vertical .le-long .le-quote { font-size: 25px; }
  .le-vertical .le-dense .le-quote { font-size: 23px; }
  .le-vertical .le-punchline { margin-top: 10px; }
  .le-vertical .le-footer { justify-content: space-between; margin: 0 18px; font-size: 9px; letter-spacing: 0.4px; }
  .le-vertical .le-footer-year { display: inline; }
  .le-quadrant .le-body { gap: 20px; padding: 12px 14px 12px 10px; }
  .le-quadrant .le-date { flex-basis: 94px; }
  .le-quadrant .le-number { font-size: 78px; margin: 5px 0; }
  .le-quadrant .le-weekday, .le-quadrant .le-month { font-size: 10px; letter-spacing: 0.35px; }
  .le-quadrant .le-quote { font-size: 22px; letter-spacing: -0.2px; }
  .le-quadrant .le-long .le-quote { font-size: 20px; }
  .le-quadrant .le-dense .le-quote { font-size: 18px; }
  .le-quadrant .le-setup { font-size: 0.68em; }
  .le-quadrant .le-punchline { margin-top: 7px; }
  .screen--lg .le-full .le-body { gap: 58px; padding: 28px 44px 28px 34px; }
  .screen--lg .le-full .le-date { flex-basis: 310px; }
  .screen--lg .le-full .le-number { font-size: 280px; line-height: 1; }
  .screen--lg .le-full .le-weekday, .screen--lg .le-full .le-month { font-size: 18px; letter-spacing: 2px; }
  .screen--lg .le-full .le-quote { font-size: 54px; }
  .screen--lg .le-full .le-long .le-quote { font-size: 48px; }
  .screen--lg .le-full .le-dense .le-quote { font-size: 44px; }
  .screen--lg .le-full .le-brand { font-size: 25px; }
  .screen--lg .le-full .le-masthead { margin: 23px 34px 0; }
  .screen--lg .le-full .le-binding { height: 27px; flex-basis: 27px; background: linear-gradient(to bottom, #000 0, #000 13px, #fff 13px, #fff 100%); }
  .screen--lg .le-full .le-binding::before, .screen--lg .le-full .le-binding::after { top: 4px; height: 4px; width: 30px; }
  .screen--lg .le-full .le-footer { margin: 0 34px; padding-bottom: 15px; font-size: 12px; }
  .screen--lg .le-horizontal .le-number { font-size: 158px; }
  .screen--lg .le-horizontal .le-date { flex-basis: 220px; }
  .screen--lg .le-horizontal .le-weekday, .screen--lg .le-horizontal .le-month { font-size: 14px; }
  .screen--lg .le-horizontal .le-quote { font-size: 42px; }
  .screen--lg .le-horizontal .le-long .le-quote { font-size: 38px; }
  .screen--lg .le-horizontal .le-dense .le-quote { font-size: 35px; }
  .screen--lg .le-horizontal .le-body { padding: 18px 32px; gap: 44px; }
  .screen--lg .le-vertical .le-number { font-size: 190px; }
  .screen--lg .le-vertical .le-weekday, .screen--lg .le-vertical .le-month { font-size: 14px; }
  .screen--lg .le-vertical .le-body { gap: 32px; padding: 24px 32px; }
  .screen--lg .le-vertical .le-quote { font-size: 40px; }
  .screen--lg .le-vertical .le-long .le-quote { font-size: 36px; }
  .screen--lg .le-vertical .le-dense .le-quote { font-size: 33px; }
  .screen--lg .le-vertical .le-footer { font-size: 11px; padding-bottom: 12px; }
  .screen--lg .le-quadrant .le-number { font-size: 122px; }
  .screen--lg .le-quadrant .le-date { flex-basis: 146px; }
  .screen--lg .le-quadrant .le-weekday, .screen--lg .le-quadrant .le-month { font-size: 13px; }
  .screen--lg .le-quadrant .le-body { gap: 28px; padding: 18px; }
  .screen--lg .le-quadrant .le-quote { font-size: 31px; }
  .screen--lg .le-quadrant .le-long .le-quote { font-size: 28px; }
  .screen--lg .le-quadrant .le-dense .le-quote { font-size: 26px; }
  .screen--portrait .le-full .le-body { flex-direction: column; justify-content: center; gap: 42px; padding: 30px 48px; }
  .screen--portrait .le-full .le-date { flex: 0 0 auto; }
  .screen--portrait .le-full .le-number { font-size: 260px; }
  .screen--portrait .le-full .le-quote { flex: 0 0 auto; width: 100%; font-size: 51px; }
  .screen--portrait .le-full .le-long .le-quote { font-size: 46px; }
  .screen--portrait .le-full .le-dense .le-quote { font-size: 42px; }
  .screen--portrait .le-vertical .le-number { font-size: 172px; }
  .screen--portrait .le-vertical .le-quote { font-size: 32px; }
  .screen--portrait .le-vertical .le-long .le-quote { font-size: 29px; }
  .screen--portrait .le-vertical .le-dense .le-quote { font-size: 26px; }
  .screen--portrait .le-quadrant .le-body { flex-direction: column; justify-content: center; gap: 20px; padding: 16px 22px; }
  .screen--portrait .le-quadrant .le-date { flex: 0 0 auto; }
  .screen--portrait .le-quadrant .le-number { font-size: 116px; }
  .screen--portrait .le-quadrant .le-quote { flex: 0 0 auto; width: 100%; text-align: center; font-size: 27px; }
  .screen--portrait .le-quadrant .le-long .le-quote { font-size: 24px; }
  .screen--portrait .le-quadrant .le-dense .le-quote { font-size: 22px; }
</style>

{%- capture le_calendar -%}
<article class="le-paper {{ le_length_class }}" lang="{{ le_language }}" aria-label="{{ le_tagline | escape }} {{ le_date }}" data-entry-id="{{ le_entry_id | escape }}" data-local-date="{{ le_date }}">
  <div class="le-binding" aria-hidden="true"></div>
  <header class="le-masthead"><span class="le-brand">Low Expectations</span><span class="le-edition">{{ le_year }}</span></header>
  <div class="le-body">
    <div class="le-date" aria-label="{{ le_date }}">
      <div class="le-weekday">{{ le_weekday }}</div>
      <div class="le-number">{{ le_day }}</div>
      <div class="le-month">{{ le_month }}</div>
    </div>
    <blockquote class="le-quote">{% if le_quote_lines.size > 1 %}<span class="le-setup">{{ le_quote_lines.first | escape }}</span><span class="le-punchline">{{ le_quote_lines | slice: 1, 99 | join: " " | escape }}</span>{% else %}{{ le_quote | escape }}{% endif %}</blockquote>
  </div>
  <footer class="le-footer">
    <span class="le-footer-year">{{ le_year }}</span>
    <span>{{ le_day_label }} {{ le_day_of_year }} {{ le_of_label }} {{ le_days_in_year }}</span>
  </footer>
</article>
{%- endcapture -%}
{%- capture le_icon -%}
<svg class="image le-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
  <path d="M4 5h16v16H4zM4 10h16M8 2v6M16 2v6M8 15h8"/>
</svg>
{%- endcapture -%}
